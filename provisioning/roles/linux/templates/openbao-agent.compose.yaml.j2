name: secrets
services:
{% set render_check -%}
files=$$(awk -F '"' '/^[[:space:]]*"destination"[[:space:]]*:/ { print $4 } /^[[:space:]]*destination[[:space:]]*=/ { print $2 }' /agent/agent.hcl) || exit 1;
test -n "$$files" || exit 1;
for file in $$files; do
case "$$file" in /cache/*.env|/rendered/core.config.toml) ;; *) exit 1;; esac;
test -f "$$file" && test -s "$$file" && test -r "$$file" || exit 1;
done
{%- endset %}
{% for agent in onboardrr_agent_specs | default([{'variant': onboardrr_agent_variant, 'directory': onboardrr_agent_directory, 'output': onboardrr_agent_output}]) %}
{% set onboardrr_agent_variant = agent.variant %}
{% set onboardrr_agent_directory = agent.directory %}
{% set onboardrr_agent_output = agent.output %}
  openbao-agent-{{ onboardrr_agent_variant }}:
{% if onboardrr_agent_variant == 'komodo' %}
    cap_drop: [ALL]
    entrypoint: ["/usr/bin/bao", "agent", "-config=/agent/agent.hcl"]
{% else %}
    command: [agent, -config=/agent/agent.hcl]
{% endif %}
    container_name: openbao-agent-{{ onboardrr_agent_variant }}
    healthcheck:
      interval: 30s
      retries: 3
      start_period: 45s
      test: ["CMD-SHELL", {{ render_check | replace('\n', ' ') | to_json }}]
      timeout: 5s
    image: ghcr.io/openbao/openbao:2.7.3
    labels:
      docker.stack: secrets
      homepage.href: {{ onboardrr_compose_agent.url | replace('$', '$$') | to_json }}
      homepage.group: {{ ('Docker ' ~ onboardrr_name) | to_json }}
      homepage.icon: sh-openbao
      homepage.name: openbao-agent-{{ onboardrr_agent_variant }}
      komodo.skip:
{% if (onboardrr_kuma.stdout | from_json).local %}
      kuma.__docker: '"{{ onboardrr_name }}", "socket", "/var/run/docker.sock"'
{% else %}
      kuma.__docker: '"{{ onboardrr_name }}", "tcp", "http://{{ onboardrr_openbao_host_ip }}:{{ onboardrr_openbao_docker_api_port | int }}"'
{% endif %}
      wud.display.icon: sh-openbao
      wud.display.name: openbao-agent-{{ onboardrr_agent_variant }}
      wud.link.template: https://github.com/{{ 'openbao/openbao' if onboardrr_agent_variant == 'komodo' else 'moghtech/komodo' }}/releases
      wud.tag.include: '^\d+\.\d+\.\d+$$'
{% if onboardrr_openbao_internal_endpoint %}
    networks: [openbao]
{% elif onboardrr_agent_variant == 'compose' %}
    network_mode: bridge
{% endif %}
    restart: always
{% if onboardrr_agent_variant == 'komodo' %}
    security_opt: [no-new-privileges:true]
{% endif %}
    user: "{{ onboardrr_account[1] }}:{{ onboardrr_account[2] }}"
    volumes:
      - type: bind
        source: {{ (onboardrr_agent_directory ~ '/agent') | replace('$', '$$') | to_json }}
        target: /agent
        read_only: true
      - type: bind
        source: {{ (onboardrr_agent_directory ~ '/' ~ onboardrr_agent_output) | replace('$', '$$') | to_json }}
        target: /{{ onboardrr_agent_output }}
{% endfor %}
{% if onboardrr_openbao_internal_endpoint %}
networks:
  openbao:
    external: true
    name: {{ onboardrr_openbao_internal_endpoint.network | replace('$', '$$') | to_json }}
{% endif %}
